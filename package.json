{
  "name": "no-paste",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that blocks text paste operations on webpages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Charlie284/no-paste.git"
  },
  "bugs": {
    "url": "https://github.com/Charlie284/no-paste/issues"
  },
  "homepage": "https://github.com/Charlie284/no-paste#readme",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "node --import tsx scripts/build.ts",
    "check": "pnpm run typecheck && pnpm run test:unit && pnpm run test:e2e",
    "package": "node --import tsx scripts/package.ts",
    "test": "pnpm run test:unit",
    "test:e2e": "pnpm run build && playwright test",
    "test:unit": "pnpm run build && node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.19.0"
}

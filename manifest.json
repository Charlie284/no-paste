{
  "manifest_version": 3,
  "name": "No Paste",
  "version": "1.0.0",
  "description": "Blocks paste operations on webpages.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
